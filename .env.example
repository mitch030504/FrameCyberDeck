# Optional catalog API key for an authorized catalog endpoint.
# Local sideloading and Steam Frame management work without it.
#
# Development:
#   copy this file to .env and fill in VRSRC_API_KEY, or export
#   FRAME_CYBERDECK_API_KEY in the shell before running npm run dev.
#
# Never commit a real credential.
VRSRC_API_KEY=
